# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# EAS project ID used by Expo push notifications.
# Find it with: eas project:info
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_uuid_here

# Google Maps API Keys
# Enable in Google Cloud: Maps SDK for Android, Maps SDK for iOS,
# Places API, and Directions API. Billing must be on.
# Expo Go (Android SDK 57) cannot use your key — use a development build:
#   npx expo run:android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=your_google_directions_api_key_here

# Phase 3 SafeRoute A* API (default: Android emulator → host)
# EXPO_PUBLIC_ROUTING_API_URL=http://10.0.2.2:8000
# iOS simulator / web: http://127.0.0.1:8000
# Physical device: http://<your-lan-ip>:8000
EXPO_PUBLIC_ROUTING_API_URL=http://10.0.2.2:8000

# ---- Routing API server (set on Railway / the machine running uvicorn) ----
# Service-account key (raw JSON or base64) for the Firebase project the app uses.
# Lets the server pull live community reports from Firestore.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# How often the server re-syncs reports and reloads scores (minutes, min 1).
# COMMUNITY_SYNC_MINUTES=15
# Shared secret for POST /admin/reload (header X-Admin-Token). Unset = endpoint disabled.
# SAFEROUTE_ADMIN_TOKEN=
# Timezone used for day/night weighting of routes and reports.
# SAFEROUTE_TZ=Asia/Kolkata

# ---- Monthly lighting refresh (GitHub Actions secrets) ----
# EE_SERVICE_ACCOUNT_JSON=   Earth Engine-registered service-account key
# EE_PROJECT=                Cloud project with the Earth Engine API enabled
# SAFEROUTE_API_URL=         optional: deployed API base URL, to hot-reload after refresh
# SAFEROUTE_ADMIN_TOKEN=     optional: same token as above
